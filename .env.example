APP_ENV=local
APP_DEBUG=false
APP_KEY=
SIMORA_DATA_MODE=demo
SIMORA_LIVE_SOURCE_ENABLED=false
SIMORA_AUTO_TRADE_ENABLED=false
SIMORA_DB_DSN="mysql:host=127.0.0.1;port=33080;dbname=simora_dev;charset=utf8mb4"
SIMORA_DB_USER=simora_app
SIMORA_DB_PASSWORD=
SIMORA_MIGRATION_DB_USER=simora_migrator
SIMORA_MIGRATION_DB_PASSWORD=
SIMORA_MIGRATION_ACTOR=local_development
SIMORA_BUILD_SHA=local

# Paystack test integration only. No live collection or payouts are implemented.
SIMORA_PAYMENTS_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_ACCOUNT=unconfigured
PAYSTACK_SECRET_KEY=
PAYSTACK_SIGNATURE_MODE=timestamped
# JSON object mapping dashboard whk_ key IDs to whsec_ signing secrets; never commit real values.
PAYSTACK_WEBHOOK_KEYS={}
PAYSTACK_CALLBACK_URL=
# Explicit bounded sandbox test window; expired/missing values fail closed.
SIMORA_SANDBOX_APPROVAL_EXPIRES_AT=1970-01-01T00:00:00Z

# Phase 11: no production feature is approved/enabled by defining a flag alone.
SIMORA_REFERRALS_ENABLED=false
SIMORA_REVIEWS_ENABLED=false
SIMORA_SUPPORT_ENABLED=false
SIMORA_CHAT_ENABLED=false
SIMORA_EXPERIENCE_APPROVAL_REFERENCE=
SIMORA_EXPERIENCE_PRIVACY_REFERENCE=
SIMORA_EXPERIENCE_MODERATION_REFERENCE=
SIMORA_EXPERIENCE_RETENTION_REFERENCE=
SIMORA_EXPERIENCE_APPROVAL_EXPIRES_AT=1970-01-01T00:00:00Z
SIMORA_EXPERIENCE_WRITES_MINUTE=5
SIMORA_EXPERIENCE_READS_MINUTE=60
SIMORA_EXPERIENCE_TICKETS_DAY=5
SIMORA_CHAT_MODERATION_OWNER=
SIMORA_CHAT_PRIVACY_OWNER=
SIMORA_CHAT_ABUSE_PROCESS_REFERENCE=
SIMORA_CHAT_RIGHTS_PROCESS_REFERENCE=
# Referral tracking, rewards, payouts and live widget integration have no enable switch in this implementation.
